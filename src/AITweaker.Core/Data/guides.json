[
  {
    "id": "discord",
    "name": "Discord",
    "icon": "discord",
    "detect": "app.discord",
    "source": "master",
    "summary": {
      "ru": "Оверлей выключен, без автозапуска, минимум анимаций и фоновой активности, приватность данных.",
      "en": "Overlay off, no autostart, minimal animations and background activity, data privacy."
    },
    "autoTweaks": ["apps.autostart.cleanup"],
    "sections": [
      {
        "title": { "ru": "Игровой оверлей", "en": "Game Overlay" },
        "path": "User Settings → Game Overlay",
        "image": "discord-overlay.webp",
        "settings": [
          { "name": "Enable Overlay", "value": "OFF" },
          { "name": "Enable Legacy Overlay", "value": "OFF" },
          { "name": "Enable overlay clickable regions", "value": "OFF" }
        ]
      },
      {
        "title": { "ru": "Система", "en": "System" },
        "path": "User Settings → System → General",
        "image": "discord-system.webp",
        "settings": [
          { "name": "Automatically open Discord when your computer starts up", "value": "OFF" },
          { "name": "Start Discord minimized", "value": "OFF" },
          { "name": "Minimize Discord to System Tray", "value": "ON" },
          { "name": "Enable Hardware Acceleration", "value": "ON", "note": { "ru": "Выключайте, только если видите артефакты или просадки FPS в играх.", "en": "Turn off only if you see glitches or FPS drops in games." } }
        ]
      },
      {
        "title": { "ru": "Анимации (Accessibility → Reduced Motion)", "en": "Animations (Accessibility → Reduced Motion)" },
        "path": "User Settings → Accessibility → Reduced Motion",
        "image": "discord-reduced-motion.webp",
        "settings": [
          { "name": "Sync with computer setting", "value": "ON" },
          { "name": "Play GIFs when Discord is focused", "value": "OFF" },
          { "name": "Play animated emoji", "value": "OFF" },
          { "name": "Play sticker animations", "value": "Never animate" }
        ]
      },
      {
        "title": { "ru": "Поле ввода и поиск", "en": "Chat box & search" },
        "path": "User Settings → Appearance → Chat Box / Search",
        "image": "discord-chatbox.webp",
        "settings": [
          { "name": "Preview emoji, mentions, and markdown syntax as you type", "value": "ON" },
          { "name": "Automatically convert emoticons in your messages to emoji", "value": "OFF" },
          { "name": "Show stickers in autocomplete results", "value": "OFF" },
          { "name": "Show games in autocomplete results", "value": "OFF" },
          { "name": "Show send message button", "value": "OFF" },
          { "name": "By default, searching in DMs…", "value": "Searches only in the selected DM" }
        ]
      },
      {
        "title": { "ru": "Голос — расширенные", "en": "Voice — advanced" },
        "path": "User Settings → Voice & Video → Voice (Show Advanced Voice Settings)",
        "image": "discord-voice-advanced.webp",
        "settings": [
          { "name": "Automatic Gain Control", "value": "ON" },
          { "name": "Advanced Voice Activity", "value": "ON" },
          { "name": "Bypass System Audio Input Processing", "value": "ON" },
          { "name": "No Audio Detected Warning", "value": "ON" },
          { "name": "Switch Voice Channel Warning", "value": "ON" },
          { "name": "Attenuation Strength", "value": "0%" },
          { "name": "When I speak", "value": "OFF" },
          { "name": "When others speak", "value": "OFF" },
          { "name": "Quality Of Service", "value": "OFF", "note": { "ru": "Многие роутеры и провайдеры работают с этим флагом хуже — пинг в Discord нестабилен.", "en": "Many routers and ISPs misbehave with this flag — unstable Discord ping." } }
        ]
      },
      {
        "title": { "ru": "Стриминг и звуки", "en": "Streaming & sounds" },
        "path": "User Settings → Voice & Video → Streaming / Sounds",
        "image": "discord-streaming.webp",
        "settings": [
          { "name": "Show Stream Previews", "value": "OFF" },
          { "name": "Stream Attenuation", "value": "OFF" },
          { "name": "Use our advanced technology to capture your screen", "value": "ON" },
          { "name": "Deafen / Undeafen sounds", "value": "ON" }
        ]
      },
      {
        "title": { "ru": "Диагностика (Voice → Advanced)", "en": "Diagnostics (Voice → Advanced)" },
        "path": "User Settings → Voice & Video → Advanced (Show Diagnostic Settings)",
        "image": "discord-diagnostics.webp",
        "settings": [
          { "name": "Soundboard entrance sound", "value": "None" },
          { "name": "Stream Info Overlay", "value": "OFF" },
          { "name": "Diagnostic Audio Recording", "value": "OFF" },
          { "name": "Debug Logging", "value": "OFF" }
        ]
      },
      {
        "title": { "ru": "Уведомления", "en": "Notifications" },
        "path": "User Settings → Notifications → Overview / Sounds / Badges",
        "image": "discord-notifications.webp",
        "settings": [
          { "name": "Enable Desktop Notifications", "value": "ON" },
          { "name": "Enable Taskbar Flashing", "value": "ON" },
          { "name": "Notify me when… (streaming, anniversaries, friends online, events, profile updates)", "value": "OFF" },
          { "name": "Someone reacts to my messages", "value": "Never" },
          { "name": "New Message / New Message in current channel", "value": "ON" },
          { "name": "Enable Unread Message Badge", "value": "ON" }
        ]
      },
      {
        "title": { "ru": "Почта", "en": "Email" },
        "path": "User Settings → Notifications → Email",
        "image": "discord-email.webp",
        "settings": [
          { "name": "Communication / Social / Announcements / Tip / Recommendations Emails", "value": "OFF" }
        ]
      },
      {
        "title": { "ru": "Уведомления — расширенные", "en": "Notifications — advanced" },
        "path": "User Settings → Notifications → Advanced",
        "image": "discord-notifications-advanced.webp",
        "settings": [
          { "name": "Mobile Notification Delay", "value": "1 minute" },
          { "name": "Allow playback and usage of /tts command", "value": "OFF" },
          { "name": "Speak all messages out loud", "value": "Never" }
        ]
      },
      {
        "title": { "ru": "Данные и приватность", "en": "Data & privacy" },
        "path": "User Settings → Data & Privacy → How Discord Uses My Data",
        "image": "discord-privacy.webp",
        "settings": [
          { "name": "Use data to improve Discord", "value": "OFF" },
          { "name": "Use data to personalize my Discord experience", "value": "OFF" },
          { "name": "Use my Discord activity to personalize Sponsored Content", "value": "OFF" },
          { "name": "Use third-party data to personalize Sponsored Content", "value": "OFF" },
          { "name": "Allow my voice to be recorded in Clips", "value": "OFF" }
        ]
      }
    ]
  },
