[
  {
    "id": "look.dark",
    "category": "look",
    "level": 2,
    "name": { "ru": "Тёмная тема Windows и приложений", "en": "Dark mode for Windows and apps" },
    "description": { "ru": "Основа внешнего вида AI Tweaker: тёмные «Пуск», панель задач, Параметры, Проводник и приложения. Меньше слепит в тёмной комнате во время игры.", "en": "The base of the AI Tweaker look: dark Start, taskbar, Settings, Explorer and apps. Easier on the eyes in a dark room while gaming." },
    "actions": [
      { "type": "registry", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize", "name": "AppsUseLightTheme", "kind": "dword", "value": 0 },
      { "type": "registry", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize", "name": "SystemUsesLightTheme", "kind": "dword", "value": 0 }
    ]
  },
  {
    "id": "look.accent",
    "category": "look",
    "level": 2,
    "restartExplorer": true,
    "name": { "ru": "Акцентный цвет AI Tweaker «сигнальный янтарь»", "en": "AI Tweaker accent color 'signal amber'" },
    "description": { "ru": "Фирменный янтарный акцент AI Tweaker для кнопок, переключателей, выделения и индикаторов панели задач (с полной палитрой оттенков, как у системных цветов). Заголовки окон остаются спокойными, без заливки цветом.", "en": "AI Tweaker's signature amber accent for buttons, toggles, selection and taskbar indicators (with a full shade palette, like built-in colors). Window title bars stay calm, without color fill." },
    "actions": [
      { "type": "registry", "path": "HKCU\\Control Panel\\Desktop", "name": "AutoColorization", "kind": "dword", "value": 0 },
      { "type": "registry", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Accent", "name": "AccentPalette", "kind": "binary", "value": "+92mAPfEbgDyqTsA4HoSALhfCgCKRQcAXC4FADuP2QA=" },
      { "type": "registry", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Accent", "name": "AccentColorMenu", "kind": "dword", "value": 4279401184 },
      { "type": "registry", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Accent", "name": "StartColorMenu", "kind": "dword", "value": 4278666634 },
      { "type": "registry", "path": "HKCU\\Software\\Microsoft\\Windows\\DWM", "name": "AccentColor", "kind": "dword", "value": 4279401184 },
      { "type": "registry", "path": "HKCU\\Software\\Microsoft\\Windows\\DWM", "name": "ColorizationColor", "kind": "dword", "value": 3303045650 },
      { "type": "registry", "path": "HKCU\\Software\\Microsoft\\Windows\\DWM", "name": "ColorizationAfterglow", "kind": "dword", "value": 3303045650 },
      { "type": "registry", "path": "HKCU\\Software\\Microsoft\\Windows\\DWM", "name": "ColorPrevalence", "kind": "dword", "value": 0 },
      { "type": "registry", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize", "name": "ColorPrevalence", "kind": "dword", "value": 0 }
    ]
  },
  {
    "id": "look.wallpaper",
    "category": "look",
    "level": 2,
    "name": { "ru": "Обои AI Tweaker", "en": "AI Tweaker wallpaper" },
    "description": { "ru": "Собственные обои AI Tweaker в 4K: график времени кадра — рваный «до» и ровный «после». Тёмные, не отвлекают и не мешают значкам на рабочем столе. Отключает смену обоев «Windows: интересное» на рабочем столе.", "en": "AI Tweaker's own 4K wallpaper: a frame-time graph — jagged 'before' and flat 'after'. Dark, calm and icon-friendly. Turns off Windows Spotlight on the desktop." },
    "actions": [
      { "type": "registry", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Wallpapers", "name": "BackgroundType", "kind": "dword", "value": 0 },
      { "type": "wallpaper", "target": "desktop", "variant": "dark" }
    ]
  },
  {
    "id": "look.lockscreen",
    "category": "look",
    "level": 2,
    "name": { "ru": "Экран блокировки AI Tweaker", "en": "AI Tweaker lock screen" },
    "description": { "ru": "Наш экран блокировки вместо меняющихся картинок «Windows: интересное» с подсказками и рекламой.", "en": "Our lock screen instead of rotating Windows Spotlight images with tips and ads." },
    "actions": [
      { "type": "registry", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "RotatingLockScreenEnabled", "kind": "dword", "value": 0 },
      { "type": "registry", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "RotatingLockScreenOverlayEnabled", "kind": "dword", "value": 0 },
      { "type": "wallpaper", "target": "lock" }
    ]
  },
  {
    "id": "look.taskbar",
    "category": "look",
    "level": 2,
    "restartExplorer": true,
    "name": { "ru": "Чистая панель задач", "en": "Clean taskbar" },
    "description": { "ru": "Поиск — компактным значком, без кнопок «Представление задач» и Copilot. Больше места для ваших программ.", "en": "Search as a compact icon, no Task View or Copilot buttons. More room for your apps." },
    "actions": [
      { "type": "registry", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Search", "name": "SearchboxTaskbarMode", "kind": "dword", "value": 1 },
      { "type": "registry", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "name": "ShowTaskViewButton", "kind": "dword", "value": 0 },
      { "type": "registry", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "name": "ShowCopilotButton", "kind": "dword", "value": 0 }
    ]
  },
  {
    "id": "look.start",
    "category": "look",
    "level": 2,
    "restartExplorer": true,
    "name": { "ru": "«Пуск» без лишнего", "en": "Clutter-free Start" },
    "description": { "ru": "Больше места под закреплённые приложения, без рекомендаций, советов и уведомлений об учётной записи Microsoft.", "en": "More room for pinned apps, no recommendations, tips or Microsoft account notifications." },
    "actions": [
      { "type": "registry", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "name": "Start_Layout", "kind": "dword", "value": 1 },
      { "type": "registry", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "name": "Start_IrisRecommendations", "kind": "dword", "value": 0 },
      { "type": "registry", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "name": "Start_AccountNotifications", "kind": "dword", "value": 0 }
    ]
  },
  {
    "id": "look.this-pc",
    "category": "look",
    "level": 2,
    "restartExplorer": true,
    "name": { "ru": "«Этот компьютер» на рабочем столе", "en": "'This PC' on the desktop" },
    "description": { "ru": "Возвращает значок «Этот компьютер» — быстрый доступ к дискам и флешкам сразу после установки.", "en": "Brings back the 'This PC' icon — quick access to drives and USB sticks right after setup." },
    "actions": [
      { "type": "registry", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\HideDesktopIcons\\NewStartPanel", "name": "{20D04FE0-3AEA-1069-A2D8-08002B30309D}", "kind": "dword", "value": 0 }
    ]
  }
]
